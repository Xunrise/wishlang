{
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer", "wish", "..."]
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": false,
        "diagnostics": {
          "disabled": [
            "unresolved-method",
            "unresolved-field",
            "unresolved-path",
            "unresolved-import",
            "unresolved-assoc-item",
            "unresolved-module",
            "unresolved-macro-call"
          ]
        }
      }
    }
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": false,
    "show_other_hints": true
  }
}
